# Skopiuj do lokalnego pliku poza repozytorium, np. /etc/opencanaryd/mail-alerts.env
SMTP_SENDER=twoj.adres@gmail.com
SMTP_RECIPIENT=twoj.adres@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Haslo aplikacji przechowywane osobno w pliku 600 root:root
SMTP_PASSWORD_FILE=/etc/opencanaryd/secrets/gmail-password
